# ============================================================================
# LAYA POLYMARKET AI FINANCIAL AGENT - CONFIGURACIÓN DE ENTORNO (.env.example)
# ============================================================================
# IMPORTANTE:
# 1. Copie este archivo a `.env` en el servidor local (cp .env.example .env).
# 2. Nunca suba `.env` al repositorio ni incluya secretos en variables VITE_ o React.
# 3. Para consultar datos públicos de Polymarket (Gamma API / CLOB) NO se requiere
#    clave privada criptográfica de trading. Las órdenes reales están bloqueadas.

# Clave secreta del Gateway Privado de Ollama y Endpoints de Control del Backend
LAYA_BACKEND_API_KEY=REEMPLAZAR_CON_SECRETO_LOCAL_SERVIDOR
OLLAMA_GATEWAY_API_KEY=REEMPLAZAR_CON_SECRETO_GATEWAY_OLLAMA

# Configuración de Ollama Local (100% Inferencia Local, Cero Nube)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-polymarket-quant:3b-local
OLLAMA_VERSION=0.5.7-local
OLLAMA_TIMEOUT_SEC=4.0

# Símbolo y Mercado Principal en Polymarket
POLYMARKET_SYMBOL=POLY-BTC-5M
POLYMARKET_CANDLE_INTERVAL=5m
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# Parámetros Deterministas de Riesgo y Modo Paper (Sección 15 de la Rúbrica)
INITIAL_CAPITAL_USDC=50000.0
PAPER_FEE_RATE_PCT=0.0
PAPER_SLIPPAGE_BPS=15.0
MAX_EXPOSURE_PCT=20.0
MAX_DAILY_LOSS_PCT=5.0
MAX_DATA_AGE_SEC=360
ALLOW_LEVERAGE=false
ALLOW_SHORT_SELLING=false
ALLOW_REAL_POLYMARKET_ORDERS=false
STOP_LIQUIDATES_POSITION=false

# Persistencia SQLite
SQLITE_DB_PATH=data/polymarket_agent.db
